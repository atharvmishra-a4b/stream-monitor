  {
   "id": 16,
   "type": "table",
   "title": "Top programs by CPU",
   "description": "The programs using the most CPU over the last minute. Programs are grouped by name, so all of Chrome's processes count as one. Updated once a minute.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
