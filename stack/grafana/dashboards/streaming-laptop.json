{
 "uid": "stream-device",
 "title": "Streaming laptop",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "15s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "tags": [
  "streaming"
 ],
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "hide": 0
   },
   {
    "name": "hub",
    "label": "Hub",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(stream:laptop_status, hub)",
     "refId": "var-hub"
    },
    "definition": "label_values(stream:laptop_status, hub)",
    "multi": false,
    "includeAll": false
   },
   {
    "name": "temple",
    "label": "Temple",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(stream:laptop_status{hub=\"$hub\"}, temple)",
     "refId": "var-temple"
    },
    "definition": "label_values(stream:laptop_status{hub=\"$hub\"}, temple)",
    "multi": false,
    "includeAll": false
   },
   {
    "name": "device",
    "label": "Laptop",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(stream:laptop_status{hub=\"$hub\",temple=\"$temple\"}, device)",
     "refId": "var-device"
    },
    "definition": "label_values(stream:laptop_status{hub=\"$hub\",temple=\"$temple\"}, device)",
    "multi": false,
    "includeAll": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Status",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "stream:laptop_status{hub=\"$hub\",temple=\"$temple\",device=\"$device\"}",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       },
       {
        "color": "orange",
        "value": 2
       },
       {
        "color": "#8b93a6",
        "value": 3
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Offline",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "Healthy",
         "color": "green",
         "index": 1
        },
        "2": {
         "text": "Needs attention",
         "color": "orange",
         "index": 2
        },
        "3": {
         "text": "Standby",
         "color": "#8b93a6",
         "index": 3
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Last report",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "floor(stream:laptop_last_seen_seconds{hub=\"$hub\",temple=\"$temple\",device=\"$device\"})",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "mappings": [],
     "unit": "s",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
