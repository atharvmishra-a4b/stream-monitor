{
 "uid": "stream-fleet",
 "title": "Streaming laptops",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "15s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "tags": [
  "streaming"
 ],
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "hide": 0
   },
   {
    "name": "hub",
    "label": "Hub",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(stream:laptop_status, hub)",
     "refId": "var-hub"
    },
    "definition": "label_values(stream:laptop_status, hub)",
    "multi": true,
    "includeAll": true,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   },
   {
    "name": "temple",
    "label": "Temple",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(stream:laptop_status{hub=~\"$hub\"}, temple)",
     "refId": "var-temple"
    },
    "definition": "label_values(stream:laptop_status{hub=~\"$hub\"}, temple)",
    "multi": true,
    "includeAll": true,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Healthy",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count(stream:laptop_status{hub=~\"$hub\",temple=~\"$temple\"} == 1) or vector(0)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Needs attention",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count(stream:laptop_status{hub=~\"$hub\",temple=~\"$temple\"} == 2) or vector(0)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Offline",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count(stream:laptop_status{hub=~\"$hub\",temple=~\"$temple\"} == 0) or vector(0)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "table",
   "title": "Hubs  (click a hub to filter the laptops below)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count by (hub) (stream:laptop_status)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count by (hub) (stream:laptop_status == 1) or (count by (hub) (stream:laptop_status) * 0)",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count by (hub) (stream:laptop_status == 2) or (count by (hub) (stream:laptop_status) * 0)",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "count by (hub) (stream:laptop_status == 0) or (count by (hub) (stream:laptop_status) * 0)",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "hub": 0,
       "Value #A": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4
      },
      "renameByName": {
       "hub": "Hub",
       "Value #A": "Laptops",
       "Value #B": "Healthy",
       "Value #C": "Needs attention",
       "Value #D": "Offline"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Hub"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Show this hub",
          "url": "/d/stream-fleet/streaming-laptops?var-hub=${__value.raw}"
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Needs attention"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "transparent",
           "value": null
          },
          {
           "color": "orange",
           "value": 1
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Offline"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "transparent",
           "value": null
          },
          {
           "color": "red",
           "value": 1
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "md"
   }
  },
  {
   "id": 6,
   "type": "table",
   "title": "Laptops  (click a name for details)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 17
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (hub, temple, device) (stream:laptop_status{hub=~\"$hub\",temple=~\"$temple\"})",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (hub, temple, device) (floor(stream:laptop_last_seen_seconds{hub=~\"$hub\",temple=~\"$temple\"}))",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (hub, temple, device) (last_over_time(stream_laptop_cpu_percent{hub=~\"$hub\",temple=~\"$temple\"}[5m]))",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (hub, temple, device) (last_over_time(stream_laptop_memory_percent{hub=~\"$hub\",temple=~\"$temple\"}[5m]))",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (hub, temple, device) (last_over_time(stream_laptop_network_upload_bps{hub=~\"$hub\",temple=~\"$temple\"}[5m]))",
     "refId": "E",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (hub, temple, device) (last_over_time(stream_laptop_network_errors_per_minute{hub=~\"$hub\",temple=~\"$temple\"}[5m]))",
     "refId": "G",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "max by (hub, temple, device) (last_over_time(stream_laptop_report_latency_ms{hub=~\"$hub\",temple=~\"$temple\"}[5m]))",
     "refId": "H",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "hub": 0,
       "temple": 1,
       "device": 2,
       "Value #A": 3,
       "Value #B": 4,
       "Value #C": 5,
       "Value #D": 6,
       "Value #E": 7,
       "Value #G": 8,
       "Value #H": 9
      },
      "renameByName": {
       "hub": "Hub",
       "temple": "Temple",
       "device": "Laptop",
       "Value #A": "Status",
       "Value #B": "Last report",
       "Value #C": "CPU",
       "Value #D": "Memory",
       "Value #E": "Upload",
       "Value #G": "Errors per min",
       "Value #H": "Delay"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Status"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "Offline",
            "color": "red",
            "index": 0
           },
           "1": {
            "text": "Healthy",
            "color": "green",
            "index": 1
           },
           "2": {
            "text": "Needs attention",
            "color": "orange",
            "index": 2
           },
           "3": {
            "text": "Standby",
            "color": "#8b93a6",
            "index": 3
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "green",
           "value": 1
          },
          {
           "color": "orange",
           "value": 2
          },
          {
           "color": "#8b93a6",
           "value": 3
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Laptop"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open this laptop",
          "url": "/d/stream-device/streaming-laptop?var-hub=${__data.fields.Hub}&var-temple=${__data.fields.Temple}&var-device=${__value.raw}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Last report"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "CPU"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "text",
           "value": null
          },
          {
           "color": "red",
           "value": 90
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Memory"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "text",
           "value": null
          },
          {
           "color": "red",
           "value": 93
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upload"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bps"
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Errors per min"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 1
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "text",
           "value": null
          },
          {
           "color": "red",
           "value": 10
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Delay"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "text",
           "value": null
          },
          {
           "color": "red",
           "value": 1500
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "md",
    "sortBy": [
     {
      "displayName": "Status",
      "desc": false
     }
    ]
   }
  }
 ],
 "links": [
  {
   "title": "All laptops",
   "type": "link",
   "url": "/d/stream-fleet/streaming-laptops",
   "icon": "dashboard"
  }
 ]
}
